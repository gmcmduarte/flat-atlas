{
  "$defs": {
    "DataVenue": {
      "additionalProperties": false,
      "description": "One venue of the release, as ``meta.json`` lists it (the release banner names them).",
      "properties": {
        "acronym": {
          "title": "Acronym",
          "type": "string"
        },
        "first_year": {
          "title": "First Year",
          "type": "integer"
        },
        "last_year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Last Year"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "successor_of": {
          "description": "Venue IDs this venue continues (a rename).",
          "items": {
            "type": "string"
          },
          "title": "Successor Of",
          "type": "array"
        },
        "venue_id": {
          "title": "Venue Id",
          "type": "string"
        }
      },
      "required": [
        "venue_id",
        "acronym",
        "name",
        "first_year",
        "last_year",
        "successor_of"
      ],
      "title": "DataVenue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``meta.json``: which release the site data comes from (banner, footer, About, Cite).",
  "properties": {
    "aggregate_version": {
      "title": "Aggregate Version",
      "type": "string"
    },
    "date": {
      "title": "Date",
      "type": "string"
    },
    "fixture": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Fixture"
    },
    "release": {
      "title": "Release",
      "type": "string"
    },
    "source_fetch_dates": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Source Fetch Dates",
      "type": "object"
    },
    "tagger_version": {
      "title": "Tagger Version",
      "type": "string"
    },
    "taxonomy_version": {
      "title": "Taxonomy Version",
      "type": "string"
    },
    "topics": {
      "title": "Topics",
      "type": "integer"
    },
    "venues": {
      "items": {
        "$ref": "#/$defs/DataVenue"
      },
      "title": "Venues",
      "type": "array"
    },
    "works": {
      "title": "Works",
      "type": "integer"
    },
    "works_by_tag_status": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Works By Tag Status",
      "type": "object"
    }
  },
  "required": [
    "release",
    "date",
    "tagger_version",
    "taxonomy_version",
    "aggregate_version",
    "works",
    "works_by_tag_status",
    "topics",
    "venues",
    "source_fetch_dates"
  ],
  "title": "DataInfo",
  "type": "object"
}
